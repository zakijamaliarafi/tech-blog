---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🚀 Welcome to Ramiel Vectors Tech!</h1>
			<p>
				Hello and welcome to the official digital hub of <strong>Ramiel Vectors Tech</strong>. We are dedicated to delivering professional, evidence-based, and highly technical insights for software engineers, DevOps professionals, and tech enthusiasts.
			</p>
			<p>
				Our mission is to provide rigorous first-hand testing, objective benchmarks, and deep dives into the tools that power the modern web and infrastructure. From comparing the latest AI coding agents and frontend frameworks, to exploring zero-trust networks and hybrid cloud migrations, you'll find authoritative knowledge here.
			</p>
			<p>Explore our latest content:</p>
			<ul>
				<li>Read our latest insights in the <a href="/blog">Blog</a>.</li>
				<li>Learn more about our mission on the <a href="/about">About</a> page.</li>
			</ul>
			<p>
				Stay tuned for regular updates as we navigate the ever-evolving landscape of tech together.
			</p>
		</main>
		<Footer />
	</body>
</html>
