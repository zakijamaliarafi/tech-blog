---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🚀 Welcome to Ramiel Vectors Tech!</h1>
			<p>
				Hello and welcome to the official digital hub of <strong>Ramiel Vectors Tech</strong>. We are dedicated to exploring the cutting edge of technology, software development, and Linux systems.
			</p>
			<p>
				Our mission is to provide high-quality insights, tutorials, and deep dives into the tools that power the modern web and infrastructure. Whether you are a seasoned system administrator or a curious developer, you'll find valuable knowledge here.
			</p>
			<p>Explore our latest content:</p>
			<ul>
				<li>Read our latest insights in the <a href="/blog">Blog</a>.</li>
				<li>Learn more about our mission on the <a href="/about">About</a> page.</li>
			</ul>
			<p>
				Stay tuned for regular updates as we navigate the ever-evolving landscape of tech together.
			</p>
		</main>
		<Footer />
	</body>
</html>
