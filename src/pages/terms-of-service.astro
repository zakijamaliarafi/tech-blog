		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 1em 3em 1em;
				color: rgb(var(--gray-dark));
			}
			h1, h2, h3 {
				color: rgb(var(--black));
			}
            a {
                color: var(--accent);
            }
		</style>
	</head>
	<body>
